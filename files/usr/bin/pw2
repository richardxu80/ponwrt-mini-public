#!/bin/sh
# ============================================================
# pw2 — PassWall2 安装/更新（apk / opkg 双模式，国内镜像优先）
#   默认不走任何代理；只有显式 PW2_PROXY= 才走代理
# ============================================================
# 用法:
#   pw2                    自动取最新版，装或升
#   pw2 26.11.11 1         指定版本 + 构建号
#   pw2 force              强制重装当前版本
#   pw2 dry                只探测版本，不下载
#   PW2_PROXY=http://127.0.0.1:1082 pw2    显式走代理
#   PW2_MIRROR=https://gh-proxy.com/ pw2   指定单镜像
# ============================================================
set -u

REPO="Openwrt-Passwall/openwrt-passwall2"
GH="https://github.com/$REPO"
API="https://api.github.com/repos/$REPO/releases/latest"
MIRRORS="https://gh-proxy.com/ https://hk.gh-proxy.com/ https://ghproxy.net/ https://ghfast.top/ https://gh.llkk.cc/"
PROXY="${PW2_PROXY:-}"
C_OPTS="--connect-timeout 8 --speed-limit 4096 --speed-time 40"
RETRY="--retry 2 --retry-delay 1 --retry-all-errors"
TMP=/tmp/pw2-work
GOOD=""

ARG1="${1:-}"; ARG2="${2:-}"
FORCE=0; DRY=0
[ "${PW2_DRY:-0}" = "1" ] && DRY=1
for a in "$ARG1" "$ARG2"; do
    [ "$a" = "force" ] && FORCE=1
    [ "$a" = "dry" ] && DRY=1
done

# ---------- 包管理器与架构 ----------
if command -v apk >/dev/null 2>&1; then
    PM="apk"
else
    PM="opkg"
fi

ARCH=$(grep -o "DISTRIB_ARCH=['\"]\{0,1\}[^'\"]*" /etc/openwrt_release 2>/dev/null | head -1 | sed "s/.*=//; s/['\"]//g")
[ -z "${ARCH:-}" ] && ARCH=$(opkg print-architecture 2>/dev/null | awk '{print $2}' | grep -E '^(aarch64|arm_|x86)' | tail -1)
[ -z "${ARCH:-}" ] && { echo "无法识别架构"; exit 1; }

echo "> 包管理器: $PM    架构: $ARCH"
if [ -n "$PROXY" ]; then
    echo "> 通道: 代理 $PROXY"
else
    echo "> 通道: 国内镜像（逐源故障转移）"
    [ -n "${PW2_MIRROR:-}" ] && MIRRORS="$PW2_MIRROR"
fi

_order() { if [ -n "$GOOD" ]; then printf '%s\n' "$GOOD $MIRRORS"; else printf '%s\n' "$MIRRORS"; fi; }

net_text() {
    _u="$1"; _mt="${2:-20}"
    if [ -n "$PROXY" ]; then
        curl -fsL $RETRY $C_OPTS --max-time "$_mt" -x "$PROXY" "$_u" 2>/dev/null && return 0
        return 1
    fi
    for _m in $(_order); do
        if _t=$(curl -fsL $RETRY $C_OPTS --max-time "$_mt" "${_m}${_u}" 2>/dev/null) && [ -n "$_t" ]; then
            GOOD="$_m"; printf '%s' "$_t"; return 0
        fi
    done
    return 1
}

net_file() {
    _u="$1"; _o="$2"; _mt="${3:-300}"; _min="${4:-1024}"
    if [ -n "$PROXY" ]; then
        rm -f "$_o"
        curl -fsSL $RETRY $C_OPTS --max-time "$_mt" -x "$PROXY" -o "$_o" "$_u" 2>/dev/null
        [ -s "$_o" ] && [ "$(wc -c < "$_o")" -ge "$_min" ] && return 0
        rm -f "$_o"; return 1
    fi
    for _m in $(_order); do
        rm -f "$_o"
        if curl -fsSL $RETRY $C_OPTS --max-time "$_mt" -o "$_o" "${_m}${_u}" 2>/dev/null; then
            if [ -s "$_o" ] && [ "$(wc -c < "$_o")" -ge "$_min" ]; then
                GOOD="$_m"; return 0
            fi
        fi
        echo "  . 源失败，换下一个" >&2
        rm -f "$_o"
    done
    return 1
}

# ---------- 版本 ----------
if [ -n "$ARG1" ] && [ -n "$ARG2" ] && [ "$ARG1" != "force" ] && [ "$ARG1" != "dry" ]; then
    VER="$ARG1"; REL="$ARG2"
else
    TAG=$(net_text "$API" 15 2>/dev/null | grep -m1 '"tag_name"' | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/' || true)
    if [ -z "${TAG:-}" ]; then
        TAG=$(net_text "$GH/releases.atom" 15 2>/dev/null | grep -m2 '<title>' | tail -1 | sed -E 's/.*<title>([^<]+)<\/title>.*/\1/' || true)
    fi
    [ -z "${TAG:-}" ] && { echo "取最新 tag 失败。可 PW2_MIRROR= / PW2_PROXY= / 手传版本号"; exit 1; }
    VER="${TAG%-*}"; REL="${TAG#*-}"
fi

echo "> 目标版本: $VER 构建 r$REL"

if [ "$PM" = "apk" ]; then
    CUR=$(apk info -e luci-app-passwall2 2>/dev/null | head -1 | sed "s/luci-app-passwall2-//; s/ .*//" || true)
    EXT="apk"; PKGMODE="apk"
    F_APP="luci-app-passwall2-${VER}-r${REL}.apk"
    F_I18N="luci-i18n-passwall2-zh-cn-${VER}.apk"
    F_PKGS="packages_apk_${ARCH}.zip"
else
    CUR=$(opkg list-installed 2>/dev/null | awk '/^luci-app-passwall2 /{print $3}' || true)
    EXT="ipk"; PKGMODE="ipk"
    F_APP="luci-app-passwall2_${VER}-r${REL}_all.ipk"
    F_I18N="luci-i18n-passwall2-zh-cn_${VER}_all.ipk"
    F_PKGS="packages_ipk_${ARCH}.zip"
fi

echo "> 当前安装: ${CUR:-无}"
[ -n "$GOOD" ] && echo "> 可用镜像: $GOOD"

if [ "$DRY" = "1" ]; then
    echo "> DRY: 不下载不安装"
    echo "  ${GOOD}${GH}/releases/download/${VER}-${REL}/${F_PKGS}"
    echo "  ${GOOD}${GH}/releases/download/${VER}-${REL}/${F_APP}"
    exit 0
fi

URL="$GH/releases/download/${VER}-${REL}"

mkdir -p "$TMP"; cd "$TMP" || exit 1
rm -f ./*.apk ./*.ipk ./*.zip 2>/dev/null || true

echo "> 下载（依赖包约 51MB）..."
net_file "$URL/$F_APP"  "$F_APP"  180 1024    || { echo "luci-app 下载失败"; exit 1; }
echo "  ok $F_APP"
net_file "$URL/$F_I18N" "$F_I18N" 180 512     || { echo "中文语言包下载失败"; exit 1; }
echo "  ok $F_I18N"
net_file "$URL/$F_PKGS" "$F_PKGS" 1200 1048576 || { echo "依赖包下载失败"; exit 1; }
echo "  ok $F_PKGS ($(wc -c < "$F_PKGS") 字节)"

echo "> 校验..."
[ "$PM" = "apk" ] && { unzip -tqq "$F_APP" >/dev/null 2>&1 || tar tzf "$F_APP" >/dev/null 2>&1 || true; }
[ "$PM" = "opkg" ] && { tar tzf "$F_APP" >/dev/null 2>&1 || { echo "$F_APP 损坏"; exit 1; }; }
unzip -tqq "$F_PKGS" >/dev/null 2>&1 || { echo "依赖包 zip 损坏"; exit 1; }
echo "  ok"

echo "> 解压依赖包..."
unzip -oq "$F_PKGS" || { echo "解压失败"; exit 1; }

if [ "$PM" = "apk" ]; then
    echo "> apk update ..."
    apk update >/dev/null 2>&1 || echo "  (apk update 警告，继续)"
    echo "> 安装 ..."
    if ! apk add --allow-untrusted --force-overwrite --no-network ./*.apk 2>&1; then
        echo "标准安装失败，放开依赖检查重试"
        apk add --allow-untrusted --force-overwrite --force-broken-world --no-network ./*.apk || { echo "安装失败"; exit 1; }
    fi
else
    echo "> opkg update ..."
    opkg update >/dev/null 2>&1 || echo "  (警告，继续)"
    echo "> 安装 ..."
    if ! opkg install ./*.ipk; then
        echo "常规安装失败，用 --force-depends 重试"
        opkg install --force-depends ./*.ipk || { echo "安装失败"; exit 1; }
    fi
fi

rm -f ./*.apk ./*.ipk ./*.zip 2>/dev/null || true

echo "> 启用并重启 passwall2..."
/etc/init.d/passwall2 enable 2>/dev/null || true
/etc/init.d/passwall2 restart 2>/dev/null || true
sleep 3

if [ "$PM" = "apk" ]; then
    NEW=$(apk info -e luci-app-passwall2 2>/dev/null | head -1 | sed "s/luci-app-passwall2-//; s/ .*//" || true)
else
    NEW=$(opkg list-installed 2>/dev/null | awk '/^luci-app-passwall2 /{print $3}' || true)
fi
echo ""
echo "=========== 完成 ==========="
echo "现版本: ${NEW:-未知}"
echo "下一步: LuCI -> 服务 -> PassWall2 -> 配节点/订阅 -> 开启"
echo "内核模块已在固件里: nft-tproxy / tun / fullcone / wireguard"
